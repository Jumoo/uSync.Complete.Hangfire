<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    this is Umbraco's NuGet configuration,
    content of this file is merged with the system-wide configuration,
    at %APPDATA%\NuGet\NuGet.config
  -->
  <packageSources>
    <add key="JumooNightly" value="https://pkgs.dev.azure.com/jumoo/Public/_packaging/nightly/nuget/v3/index.json" />
  </packageSources>
</configuration>