<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Project>uSync.Hangfire</Project>
		<PackageId>uSync.Hangfire</PackageId>

		<Authors>Kevin Jump</Authors>
		<Company>Jumoo</Company>

		<PackageTags>umbraco usync hangfire umbraco-marketplace</PackageTags>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageIcon>usync-logo.png</PackageIcon>

		<Description>Hangfire helpers for uSync</Description>
		<Copyright>Copyright © 2024-5 Jumoo</Copyright>

		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Jumoo/uSync.Hangfire</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Jumoo/uSync.Hangfire</RepositoryUrl>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="16.*" />
		<PackageReference Include="Cultiv.Hangfire" Version="4.1.3">
			<ExcludeAssets>build;buildMultitargeting;buildTransitive</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="uSync" Version="16.0.3">
			<ExcludeAssets>build</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="../assets/usync-logo.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<None Include="../assets/readme.txt" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
